# Docker Compose port / credential overrides for `npm run up`.
# Copy to `.env` and edit only if a default port collides on your machine.
# NOT for the apps — each has its own apps/*/.env.example.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ordersail
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local logs (docs/observability.md → "Logs in local Grafana")
LOKI_PORT=3100
GRAFANA_PORT=3300
FLUENT_BIT_PORT=24224
# Local traces + metrics: the one OTLP endpoint (Alloy) that routes them to
# Tempo and Prometheus (docs/observability.md → "Traces in local Grafana",
# "Metrics in local Grafana"). If you change OTLP_PORT, change
# OTEL_EXPORTER_OTLP_ENDPOINT in apps/*/.env too.
OTLP_PORT=4318
ALLOY_UI_PORT=12345
PROMETHEUS_PORT=9090
# `npm run log-shipping:up` only
MERCHANT_API_LOG_SHIPPING_PORT=3020
