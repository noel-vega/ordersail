node_modules

# npm workspaces uses the single root lockfile — no per-workspace locks
apps/*/package-lock.json
packages/*/package-lock.json

.nx/cache
.nx/workspace-data
.nx/installation

.env

dist

.terraform
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.backup
crash.log

# terraform: auto-loaded local var files must never be committed (standard
# hygiene). Secrets are held in Secrets Manager, not here — see
# envs/production/alerts-recipients.tf and frontend-auth.tf.
*.auto.tfvars
*.auto.tfvars.json

# agent worktrees — full checkouts with their own node_modules
.claude/worktrees
