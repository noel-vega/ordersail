# Copy to .env — every value here works as-is against the local docker infra.
# No secrets: local Mailpit takes no SMTP auth.

# health-check only (see modules/health) — this app has no user-facing API
PORT=3003

# BullMQ connection (packages/queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# the orders processor writes orders directly (packages/db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersail

# Local Mailpit (packages/email) — SMTP on :1025, web UI at http://localhost:8025.
# This worker is the only place SMTP is configured; the APIs enqueue jobs.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Ordersail <no-reply@ordersail.local>"

# Only for a real SMTP relay (e.g. SES). Mailpit ignores auth —
# mailer.service.ts sets credentials only when SMTP_USER is present.
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# NODE_ENV=development
# LOG_LEVEL=debug   # fatal|error|warn|info|debug|trace|silent; unset → info in production, debug otherwise
