        ]
      }
    },
    "/pos/catalog": {
      "get": {
        "operationId": "CatalogController_list",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Match product name, variant SKU, or barcode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "nextCursor from the previous page",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosCatalogPage"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/catalog/scan": {
      "get": {
        "operationId": "CatalogController_scan",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "description": "A scanned barcode or a variant SKU",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosScanResult"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/catalog/{id}": {
      "get": {
        "operationId": "CatalogController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosCatalogProduct"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/session": {
      "get": {
        "operationId": "CatalogController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosSession"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/pos/orders": {
      "post": {
        "operationId": "OrdersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosOrder"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PosDevice-auth": []
          }
        ],
        "tags": [
          "orders"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "POS",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "PosDevice-auth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-pos-device-token"
      }
    },
    "schemas": {
      "PairDeviceDto": {
        "type": "object",
        "properties": {
          "pairingCode": {
            "type": "string",
            "description": "The pairing code shown in the admin dashboard"
          }
        },
        "required": [
          "pairingCode"
        ]
      },
      "PairingResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "accountId": {
            "type": "number"
          },
          "accountName": {
            "type": "string"
          },
          "locationId": {
            "type": "number"
          },
          "locationName": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "accountId",
          "accountName",
          "locationId",
          "locationName",
          "deviceName"
        ]
      },
      "PosCatalogBrand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PosCatalogCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PosCatalogImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "position": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "url",
          "position"
        ]
      },
      "PosCatalogOptionValue": {
        "type": "object",
        "properties": {
          "optionName": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "optionName",
          "value"
        ]
      },
      "PosCatalogVariant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "barcodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priceCents": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "optionValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogOptionValue"
            }
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "sku",
          "barcodes",
          "priceCents",
          "stock",
          "optionValues",
          "imageUrl"
        ]
      },
      "PosCatalogProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PosCatalogBrand"
              }
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogCategory"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogImage"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogVariant"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "brand",
          "categories",
          "images",
          "variants"
        ]
      },
      "PosCatalogPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosCatalogProduct"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "syncedAt": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "syncedAt"
        ]
      },
      "PosScanResult": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/PosCatalogProduct"
          },
          "variantId": {
            "type": "number"
          }
        },
        "required": [
          "product",
          "variantId"
        ]
      },
      "PosSession": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "number"
          },
          "accountName": {
            "type": "string"
          },
          "locationId": {
            "type": "number"
          },
          "locationName": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "accountName",
          "locationId",
          "locationName",
          "deviceName"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "variantId",
          "quantity"
        ]
      },
      "CreateOrderPaymentDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card"
            ]
          },
          "amountTenderedCents": {
            "type": "number"
          }
        },
        "required": [
          "method"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          },
          "payment": {
            "$ref": "#/components/schemas/CreateOrderPaymentDto"
          }
        },
        "required": [
          "items",
          "payment"
        ]
      },
      "PosOrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "variantId": {
            "type": "number",
            "nullable": true
          },
          "productName": {
            "type": "string"
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "optionsLabel": {
            "type": "string",
            "nullable": true
          },
          "priceCents": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "lineCents": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "variantId",
          "productName",
          "sku",
          "optionsLabel",
          "priceCents",
          "quantity",
          "lineCents"
        ]
      },
      "PosOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "channel": {
            "type": "string",
            "enum": [
              "pos"
            ]
          },
          "subtotalCents": {
            "type": "number"
          },
          "taxCents": {
            "type": "number"
          },
          "totalCents": {
            "type": "number"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "cash",
              "card"
            ]
          },
          "amountTenderedCents": {
            "type": "number",
            "nullable": true
          },
          "changeCents": {
            "type": "number",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosOrderItem"
            }
          }
        },
        "required": [
          "id",
          "channel",
          "subtotalCents",
          "taxCents",
          "totalCents",
          "paymentMethod",
          "amountTenderedCents",
          "changeCents",
          "createdAt",
          "items"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "code",
              "message",
              "doc_url",
              "request_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "invalid_request_error",
                  "authentication_error",
                  "permission_error",
                  "rate_limit_error",
                  "api_error"
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthenticated",
                  "forbidden",
                  "not_found",
                  "method_not_allowed",
                  "not_acceptable",
                  "request_timeout",
                  "conflict",
                  "gone",
                  "precondition_failed",
                  "content_too_large",
                  "unsupported_media_type",
                  "misdirected_request",
                  "unprocessable_content",
                  "rate_limited",
                  "internal_error",
                  "not_implemented",
                  "bad_gateway",
                  "service_unavailable",
                  "gateway_timeout",
                  "http_version_not_supported",
                  "validation_failed",
                  "invalid_access_token",
                  "invalid_app_key",
                  "invalid_device_token",
                  "invalid_credentials",
                  "mfa_factor_required",
                  "email_taken"
                ]
              },
              "message": {
                "type": "string",
                "description": "For people. Never parse it; branch on `code`."
              },
              "param": {
                "type": "string",
                "description": "The request field that caused the error."
              },
              "doc_url": {
                "type": "string",
                "format": "uri"
              },
              "request_id": {
                "type": "string",
                "nullable": true,
                "description": "The x-request-id of the request; quote it when reporting a problem."
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Extra data for the code; its shape per code is in ErrorDetailsByCode."
              }
            }
          }
        }
      },
      "ErrorDetailsByCode": {
        "type": "object",
        "description": "Each error code's `details` shape, keyed by code. A code that isn't listed has no fixed shape.",
        "required": [
          "validation_failed"
        ],
        "properties": {
          "validation_failed": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "param",
                    "message"
                  ],
                  "properties": {
                    "param": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "service_unavailable": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          }
        }
      }
    }
  }
}