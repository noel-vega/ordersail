DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersail
PORT=3004

# Optional: origin of any browser-based tooling that calls this API directly
# (the POS itself is a native app and doesn't need CORS). Defaults to
# reflecting the request origin when unset.
# POS_WEB_URL=http://localhost:3005

# Optional: fatal|error|warn|info|debug|trace|silent; unset → info in production, debug otherwise
# LOG_LEVEL=debug
