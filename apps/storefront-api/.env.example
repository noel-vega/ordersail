# Copy to .env and fill in STRIPE_SECRET_KEY and SHIPPO_API_KEY with your own
# Stripe/Shippo test-mode credentials.
# Everything else works as-is against the local docker infra.

# Postgres — served by the root `docker compose` stack (`npm run up`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersail

PORT=3001

# Signs customer JWTs (distinct from merchant-api's staff auth)
CUSTOMER_JWT_SECRET=dev-only-customer-jwt-secret-change-me

# Local Redis (packages/queue) — the thank-you email is enqueued for
# apps/worker. Both default to localhost:6379, so optional for local dev.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Your Stripe test-mode secret key — the platform account's key, same value
# as merchant-api (one platform, many connected merchant accounts). The
# checkout webhook lives in merchant-api now (M9), so no webhook secret here.
STRIPE_SECRET_KEY=sk_test_xxx

# Shippo test-mode token (shippo_test_...) — one platform-owned Shippo
# account, same value as merchant-api
SHIPPO_API_KEY=shippo_test_xxx

# Optional — log format toggle
# NODE_ENV=development
