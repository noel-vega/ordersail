# Copy to .env and fill in STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, and
# SHIPPO_API_KEY with your own Stripe/Shippo test-mode credentials.
# Everything else works as-is against the local docker infra.

# Postgres — served by the root `docker compose` stack (`npm run up`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersail

# Signs staff JWTs (distinct from storefront-api's customer auth)
STAFF_JWT_SECRET=dev-only-staff-jwt-secret-change-me

# Encrypts TOTP secrets at rest (OS-316) — 32 bytes, hex encoded.
# Generate your own with `openssl rand -hex 32`; this dev value is fine as-is.
MFA_ENCRYPTION_KEY=cad9392fb0a00852292d04803624321bd16278f405ce49bfedcdc864c431ccf5

# Base URL of merchant-web — builds the invite link sent to new staff, and
# is where the WebAuthn relying-party ID and expected origin are derived from
MERCHANT_WEB_URL=http://localhost:5000

# WebAuthn / passkeys (OS-485) — all optional. Unset, the RP ID is the
# hostname of MERCHANT_WEB_URL and the expected origin is its origin, which
# is correct in dev (localhost) and in prod (merchant.ordersail.com).
#
# The RP ID is baked into every credential ever issued and cannot be changed
# without invalidating all of them, so override it only deliberately.
#
# Note WebAuthn needs a secure context: localhost works over plain http, but
# reaching the dashboard over a LAN IP (http://192.168.x.x:5000, e.g. from a
# phone) fails with a confusing browser error.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:5000
# WEBAUTHN_RP_NAME=OrderSail

# Local Redis (packages/queue) — the invite email is enqueued for apps/worker.
# Both default to localhost:6379, so these are optional for local dev.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Local MinIO (packages/storage) — S3 API on :9000, web console on :9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ordersail-product-images
MINIO_PUBLIC_BASE_URL=http://localhost:9000/ordersail-product-images
# MinIO needs path-style addressing; real AWS S3 does not. Defaults to false.
MINIO_FORCE_PATH_STYLE=true

# Your Stripe test-mode secret key — the platform account's key, shared with
# storefront-api (one platform, many connected merchant accounts)
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the one Stripe event destination (Dashboard "events on
# connected accounts", or `stripe listen`) — account.updated + checkout.session.*
# all route to POST /webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shippo test-mode token (looks like shippo_test_...) — one platform-owned
# Shippo account, same value as storefront-api
SHIPPO_API_KEY=shippo_test_xxx

# Optional — HTTP port (default 3000) and log format toggle
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=debug   # fatal|error|warn|info|debug|trace|silent; unset → info in production, debug otherwise
