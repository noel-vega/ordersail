---
import Layout from '../layouts/Layout.astro';
import ComingSoon from '../components/ComingSoon.astro';

const included = [
	'Full catalog — unlimited products, variants, and images',
	'Per-location inventory with movement history',
	'Unlimited orders and customer accounts',
	'Stripe Connect payouts and refunds',
	'Crew accounts for your team',
	'The full REST API',
];

const faq = [
	{
		q: 'When will pricing be announced?',
		a: 'Before signups open. Want a heads-up, or have a question about your shop? <a href="/contact">Get in touch</a>.',
	},
	{
		q: 'Do you take a percentage of my sales?',
		a: 'OrderSail never touches your money — payments go into your own Stripe account and Stripe pays you directly.',
	},
	{
		q: 'What happens to my data if I leave?',
		a: 'It’s yours. Export your catalog, orders, and customers through the API. See the <a href="/faq">FAQ</a>.',
	},
];
---

<Layout
	title="Pricing — OrderSail"
	description="What an OrderSail account includes: catalog, inventory, orders, Stripe payouts, team accounts, and the full API. Pricing is announced before signups open."
>
	<section class="head">
		<p class="eyebrow">Pricing</p>
		<h1>Pricing announced at launch.</h1>
		<p class="lede">
			We’re finalizing plans now. Here’s what an OrderSail account includes —
			and payments always run through your own Stripe account.
		</p>
	</section>

	<section class="card">
		<div class="card-head">
			<span class="per">What’s included</span>
		</div>
		<ul class="included">
			{included.map((i) => <li>{i}</li>)}
		</ul>
		<ComingSoon bare />
		<p class="fine">Plans and pricing are announced before signups open.</p>
	</section>

	<section class="note">
		<h2>Payment processing</h2>
		<p>
			Stripe charges its standard processing fee on each sale, billed by Stripe.
			Connect your own Stripe account and payouts go straight to your bank —
			OrderSail never holds your money.
		</p>
	</section>

	<section class="group">
		<h2 class="group-title">Common questions</h2>
		<dl>
			{
				faq.map((item) => (
					<div class="qa">
						<dt>{item.q}</dt>
						<dd set:html={item.a} />
					</div>
				))
			}
		</dl>
	</section>

	<section class="cta">
		<h2>Want to hear first?</h2>
		<ComingSoon />
	</section>
</Layout>

<style>
	.head {
		padding: 40px 0 40px;
	}
	.head h1 {
		font-family: Georgia, serif;
		font-size: clamp(2rem, 5vw, 3.4rem);
		line-height: 1.08;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin: 0 0 22px;
		max-width: 18ch;
	}
	.lede {
		font-family: system-ui, sans-serif;
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--ink-dim);
		max-width: 54ch;
		margin: 0;
	}

	.card {
		border: 1px solid var(--line);
		padding: 36px;
		max-width: 520px;
		margin: 16px 0 56px;
	}
	.card-head {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-bottom: 24px;
	}
	.per {
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-dim);
	}
	.included {
		list-style: none;
		margin: 0 0 28px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.included li {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		padding-left: 22px;
		position: relative;
	}
	.included li::before {
		content: '→';
		position: absolute;
		left: 0;
		color: var(--ink);
	}
	.fine {
		font-family: system-ui, sans-serif;
		font-size: 0.85rem;
		color: var(--ink-dim);
		margin: 18px 0 0;
	}

	.note {
		padding: 8px 0 40px;
		max-width: 60ch;
	}
	.note h2 {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 400;
		color: var(--ink-dim);
		margin: 32px 0 12px;
	}
	.note p {
		font-family: system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--ink-dim);
		margin: 0;
	}

	.group {
		padding: 32px 0;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.group-title {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 400;
		color: var(--ink-dim);
		margin: 0 0 24px;
	}
	dl {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.qa {
		max-width: 62ch;
	}
	dt {
		font-family: Georgia, serif;
		font-size: 1.1rem;
		margin: 0 0 6px;
	}
	dd {
		font-family: system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--ink-dim);
		margin: 0;
	}
	dd :global(a) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.cta {
		padding: 72px 0 90px;
		text-align: center;
		border-top: 1px solid var(--line);
		margin-top: 24px;
	}
	.cta h2 {
		font-family: Georgia, serif;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		font-weight: 400;
		letter-spacing: -0.01em;
		margin: 0 0 12px;
	}

	@media (max-width: 720px) {
		.card {
			padding: 28px;
		}
	}
</style>
