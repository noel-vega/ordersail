---
import Layout from '../layouts/Layout.astro';
import ComingSoon from '../components/ComingSoon.astro';

const problems = [
	{
		title: 'Too many disconnected tools',
		desc: 'Inventory in one app, orders in another, payments somewhere else — nothing talks to each other.',
	},
	{
		title: "Inventory that doesn't reflect reality",
		desc: 'A single stock number that drifts out of sync the moment you sell somewhere else.',
	},
	{
		title: 'Payouts you can’t trace',
		desc: 'Money moves, but connecting an order to what landed in your account takes a spreadsheet.',
	},
];

const features = [
	{ n: '01', title: 'Products & inventory', desc: 'Catalog and per-location stock with a full movement history.' },
	{ n: '02', title: 'Orders & carts', desc: 'Every order and open cart in one list, from click to delivery.' },
	{ n: '03', title: 'Payments', desc: 'Stripe Connect payouts and refunds, tied to every order.' },
	{ n: '04', title: 'Developer API', desc: 'A documented REST API — build your own storefront.' },
];
---

<Layout>
	<section class="hero">
		<p class="eyebrow">Charting commerce for small business — Est. 2026</p>
		<h1>Set sail with your store.</h1>
		<p class="lede">
			One system for your products, storefront, point of sale, orders, and
			payouts — no separate tools, no duct-taped integrations.
		</p>
		<div class="actions">
			<ComingSoon bare />
			<a class="btn-line" href="/features">See what it does</a>
		</div>
	</section>

	<section class="problem">
		<p class="eyebrow">Rough waters</p>
		<h2 class="problem-title">Running a store shouldn't feel like this.</h2>
		<div class="problem-grid">
			{
				problems.map((p) => (
					<div class="problem-item">
						<h3>{p.title}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
		<div class="solution">
			<h2 class="solution-title">One deck. Everything in view.</h2>
			<p>
				OrderSail brings your catalog, inventory, orders, payments, and shipping
				into a single system — real per-location stock, Stripe Connect payouts
				that go straight to you, and shipping labels bought right from the order.
			</p>
		</div>
	</section>

	<hr class="rule" />

	<section class="index">
		<div class="index-head">
			<h2>What's aboard</h2>
			<a class="more" href="/features">See all features →</a>
		</div>
		<div class="list">
			{
				features.map((f) => (
					<div class="row">
						<span class="row-n">{f.n}</span>
						<h3>{f.title}</h3>
						<p>{f.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="how">
		<p class="eyebrow">The voyage</p>
		<h2>Create an account, add products, connect Stripe — then OrderSail runs the sale from the customer's first click to a delivered package.</h2>
		<a class="more" href="/how-it-works">How it works →</a>
	</section>

	<section class="final">
		<h2>Set sail soon.</h2>
		<ComingSoon />
	</section>
</Layout>

<style>
	.hero {
		padding: 24px 0 64px;
	}
	.hero .eyebrow {
		margin: 0 0 18px;
	}
	.hero h1 {
		font-size: clamp(2.2rem, 6vw, 4.4rem);
		line-height: 1.05;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin: 0 0 20px;
		max-width: 15ch;
	}
	.lede {
		font-family: system-ui, sans-serif;
		font-size: 1.08rem;
		line-height: 1.55;
		color: var(--ink-dim);
		max-width: 48ch;
		margin: 0 0 28px;
	}
	.actions {
		display: flex;
		gap: 24px;
		align-items: center;
		flex-wrap: wrap;
	}

	.problem {
		padding: 24px 0 70px;
	}
	.problem-title {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.6rem, 3.4vw, 2.2rem);
		letter-spacing: -0.01em;
		max-width: 24ch;
		margin: 0 0 44px;
	}
	.problem-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 36px 48px;
		margin: 0 0 56px;
	}
	.problem-item {
		padding-top: 20px;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.problem-item h3 {
		font-family: Georgia, serif;
		font-size: 1.1rem;
		font-weight: 400;
		margin: 0 0 8px;
	}
	.problem-item p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}
	.solution {
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}
	.solution-title {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		letter-spacing: -0.01em;
		margin: 0 0 18px;
	}
	.solution p {
		font-family: system-ui, sans-serif;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--ink-dim);
		max-width: 58ch;
		margin: 0;
	}

	.index {
		padding: 60px 0;
	}
	.index-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin: 0 0 40px;
	}
	.index-head h2 {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 400;
		color: var(--ink-dim);
		margin: 0;
	}
	.more {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
		white-space: nowrap;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.row {
		display: grid;
		grid-template-columns: 60px 260px 1fr;
		align-items: baseline;
		gap: 20px;
		padding: 22px 0;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.row-n {
		font-family: ui-monospace, monospace;
		font-size: 0.85rem;
		color: var(--ink-dim);
	}
	.row h3 {
		font-size: 1.15rem;
		font-weight: 400;
		margin: 0;
	}
	.row p {
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		color: var(--ink-dim);
		line-height: 1.5;
		margin: 0;
	}

	.how {
		padding: 60px 0;
	}
	.how h2 {
		font-family: Georgia, serif;
		font-weight: 400;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		line-height: 1.4;
		letter-spacing: -0.01em;
		max-width: 46ch;
		margin: 0 0 24px;
	}

	.final {
		padding: 90px 0;
		text-align: center;
		--cta-note-gap: 32px;
	}
	.final h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		color: var(--ink);
		letter-spacing: -0.01em;
		font-family: Georgia, serif;
		font-weight: 400;
		margin: 0 0 12px;
	}

	@media (max-width: 720px) {
		.problem-grid {
			grid-template-columns: 1fr;
		}
		.row {
			grid-template-columns: 1fr;
			gap: 8px;
		}
	}
</style>
