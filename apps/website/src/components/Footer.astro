---
import { signupUrl, signinUrl } from '../lib/urls';

const year = new Date().getFullYear();

const columns = [
	{
		title: 'Product',
		links: [
			{ href: '/features', label: 'Features' },
			{ href: '/pricing', label: 'Pricing' },
			{ href: '/how-it-works', label: 'How it works' },
			{ href: '/faq', label: 'FAQ' },
		],
	},
	{
		title: 'Legal',
		links: [
			{ href: '/terms', label: 'Terms of Service' },
			{ href: '/privacy', label: 'Privacy Policy' },
			{ href: '/acceptable-use', label: 'Acceptable Use' },
		],
	},
	{
		title: 'Company',
		links: [{ href: '/contact', label: 'Contact' }],
	},
	{
		title: 'Get started',
		links: [
			{ href: signupUrl, label: 'Start selling' },
			{ href: signinUrl, label: 'Sign in' },
		],
	},
];
---

<footer class="foot">
	<div class="foot-inner">
		<nav class="cols" aria-label="Footer">
			{
				columns.map((c) => (
					<div class="col">
						<h2>{c.title}</h2>
						<ul>
							{c.links.map((l) => (
								<li>
									<a href={l.href}>{l.label}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
		<div class="meta">
			<span>
				<span class="mark">OrderSail</span>
				<span>&copy; {year} — charting commerce for small business</span>
			</span>
			<a href="mailto:support@ordersail.com">support@ordersail.com</a>
		</div>
	</div>
</footer>

<style>
	.foot {
		border-top: 1px solid var(--line);
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		color: var(--ink-dim);
	}
	.foot-inner {
		max-width: 980px;
		margin: 0 auto;
		padding: 40px 28px 60px;
	}
	.cols {
		display: flex;
		flex-wrap: wrap;
		gap: 40px 64px;
		margin: 0 0 40px;
	}
	.col h2 {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 400;
		color: var(--ink);
		margin: 0 0 14px;
	}
	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.col a {
		text-decoration: none;
	}
	.col a:hover {
		text-decoration: underline;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		gap: 8px 16px;
		flex-wrap: wrap;
		padding-top: 24px;
		border-top: 1px solid color-mix(in srgb, var(--line) 20%, transparent);
	}
	.meta > span {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 12px;
	}
	.meta .mark {
		font-weight: 700;
		color: var(--ink);
	}
	.meta a {
		text-decoration: none;
	}
	.meta a:hover {
		text-decoration: underline;
	}
</style>
