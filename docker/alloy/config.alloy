// Local telemetry gateway for `npm run dev` (OS-734, OS-738; the decision is
// docs/adr/0002-alloy-telemetry-gateway.md). Every signal passes through here:
//
//   traces, metrics  services → OTLP :4318 (published by docker-compose.yml)
//                    → Tempo / Prometheus
//   logs             Fluent Bit → Loki push API :3100 (internal) → Loki
//
// Pipeline graph and live component state: Alloy's UI (ALLOY_UI_PORT).

logging {
  level = "warn"
}

otelcol.receiver.otlp "default" {
  // what packages/tracing and packages/metrics speak: OTLP over HTTP, protobuf
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlphttp.tempo.input]
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
  }
}

// appends /v1/traces
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// Prometheus's native OTLP receiver; appends /v1/metrics. Exponential
// histograms land as native histograms, the same as Grafana Cloud Mimir.
otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

// --- logs ---------------------------------------------------------------------

// Fluent Bit's `loki` outputs (docker/fluent-bit/dev.conf) push here exactly as
// they would to Loki: the same push API, on Loki's own port, inside the compose
// network. Each entry passes through untouched — the raw pino JSON line and
// the labels Fluent Bit set (service_name, deployment_environment) — so saved
// queries and the trace ↔ log links can't tell the difference.
loki.source.api "fluent_bit" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3100
  }

  // the default (false) restamps every line with the time Alloy received it
  use_incoming_timestamp = true

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
