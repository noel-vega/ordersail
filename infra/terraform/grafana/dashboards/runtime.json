{
  "uid": "ordersail-runtime",
  "title": "Node runtime (OpenTelemetry)",
  "description": "Event loop, heap, GC, CPU and handles from inside each API process (packages/metrics, OS-735), per service and instance (OS-737). Managed by Terraform: infra/terraform/grafana \u2014 edits made in the UI are overwritten on the next apply. Works against Grafana Cloud Mimir and the local Prometheus.",
  "tags": [
    "ordersail",
    "runtime",
    "opentelemetry"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(grafanacloud-ordersail-prom|Prometheus)$/",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "merchant-api,storefront-api,pos-api",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "count by (job, instance) (target_info{job=~\"$service\"}) unless count by (job, instance) (target_info{job=~\"$service\"} offset 2m)",
        "step": "60s",
        "titleFormat": "New {{job}} instance",
        "textFormat": "{{instance}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Infrastructure (CloudWatch)",
      "type": "link",
      "url": "/d/ordersail-infra",
      "icon": "dashboard",
      "tooltip": "ECS task CPU and memory, ALB, RDS, Redis"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live instances",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Processes that reported in the last 2 minutes. OTLP-pushed series have no staleness marker, so a plain query would keep counting a stopped task for minutes (docs/observability.md \u2192 Metrics in production).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (job) (last_over_time(target_info{job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Event-loop utilization",
      "description": "Share of time the event loop was busy rather than idle. The clearest single signal that a service is CPU-bound in JS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (job) (nodejs_eventloop_utilization_ratio{job=~\"$service\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Event loop",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event-loop delay p99",
      "description": "How late timers fire. The sampler's resolution is 10ms, so an idle process reads ~10\u201311ms (the orange line). Movement above it is real blocking.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job) (nodejs_eventloop_delay_p99_seconds{job=~\"$service\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event-loop delay max",
      "description": "The worst stall in each 60s export window \u2014 a single synchronous burst (a big JSON parse, a sync crypto call, a GC) shows here first.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job) (nodejs_eventloop_delay_max_seconds{job=~\"$service\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "V8 heap used",
      "description": "Per process, so each deploy starts a new line: a leak is a staircase that resets on deploy. Deploys are also marked as annotations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, instance) (v8js_memory_heap_used_bytes{job=~\"$service\"})",
          "legendFormat": "{{job}} \u00b7 {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*) \u00b7 ([0-9a-f]{8})[0-9a-f-]*",
            "renamePattern": "$1 \u00b7 $2"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Old-space heap (leak watch)",
      "description": "Long-lived objects. Steady growth here between deploys, after GC, is the classic leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, instance) (v8js_memory_heap_used_bytes{job=~\"$service\", v8js_heap_space_name=\"old_space\"})",
          "legendFormat": "{{job}} \u00b7 {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*) \u00b7 ([0-9a-f]{8})[0-9a-f-]*",
            "renamePattern": "$1 \u00b7 $2"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RSS vs heap size",
      "description": "RSS includes everything outside the V8 heap (buffers, native modules). A growing gap with a flat heap points outside JS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, instance) (process_memory_usage_bytes{job=~\"$service\"})",
          "legendFormat": "{{job}} \u00b7 {{instance}} RSS",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, instance) (v8js_memory_heap_space_size_bytes{job=~\"$service\"})",
          "legendFormat": "{{job}} \u00b7 {{instance}} heap",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*) \u00b7 ([0-9a-f]{8})[0-9a-f-]*",
            "renamePattern": "$1 \u00b7 $2"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "CPU and GC",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Process CPU (cores)",
      "description": "CPU used by the Node process, as a share of one core. Compare with the ECS task CPU on the Infrastructure board: busy here = busy in our JS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, cpu_mode) (rate(process_cpu_time_seconds_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{cpu_mode}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "heatmap",
      "title": "GC pause duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "All GC pauses as a native histogram (one series, no buckets stored). Bright cells high up = long pauses.",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(v8js_gc_duration_seconds{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "pauses",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GC time per second, by kind",
      "description": "Seconds spent in GC per second, split by major/minor/incremental, plus each service's p99 single pause.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, v8js_gc_type) (histogram_sum(rate(v8js_gc_duration_seconds{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{v8js_gc_type}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (job) (rate(v8js_gc_duration_seconds{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p99 pause",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Handles",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Active handles by type",
      "description": "Live timers, sockets and other libuv handles. A count that only climbs is a handle leak (an uncleared interval, an unclosed socket).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, v8js_resource_type) (v8js_resource_active{job=~\"$service\"})",
          "legendFormat": "{{job}} {{v8js_resource_type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
