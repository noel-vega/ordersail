{
  "uid": "ordersail-infra",
  "title": "Infrastructure (CloudWatch)",
  "description": "ECS, ALB, RDS and Redis from CloudWatch, queried live (OS-91). Managed by Terraform: infra/terraform/grafana \u2014 edits made in the UI are overwritten on the next apply.",
  "tags": [
    "ordersail",
    "infra",
    "cloudwatch"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "merchant-api : ordersail-merchant-api, storefront-api : ordersail-storefront-api, pos-api : ordersail-pos-api, worker : ordersail-worker",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "targetgroup",
        "label": "Target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "CloudWatchVariableQueryEditor-VariableQuery",
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "dimensionFilters": {
            "LoadBalancer": "app/ordersail-api/2ba61b99d891c2dc"
          }
        },
        "regex": "/(?<value>targetgroup\\/(?:${service:regex})-tg\\/.*)/",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "ECS services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU % of reservation",
      "description": "AWS/ECS CPUUtilization, average across the service's tasks. Emitted whether or not Container Insights is on.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "ordersail",
            "ServiceName": "$service"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.ServiceName')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 5
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
